# Copy this file to .env and fill in real values. Never commit the real .env.

# Server
PORT=3000

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# MySQL (the Week 4 database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tenanttrails

# JSON Web Token signing secret (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary (Console > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
