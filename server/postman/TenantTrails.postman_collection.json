{
  "info": {
    "name": "TenantTrails API",
    "description": "CSCI 4177/5709 Lab 5 — REST API for TenantTrails. Run Signup or Login first; the token is saved to the collection variable {{token}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
      }
    },
    {
      "name": "Auth - Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }",
              "pm.test('status is 201', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@dal.ca\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/signup", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signup"] }
      }
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }",
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alex@dal.ca\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "Apartments - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/apartments", "host": ["{{baseUrl}}"], "path": ["api", "apartments"] }
      }
    },
    {
      "name": "Apartments - Get one (with reviews)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/apartments/1", "host": ["{{baseUrl}}"], "path": ["api", "apartments", "1"] }
      }
    },
    {
      "name": "Apartments - Get one (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/apartments/9999", "host": ["{{baseUrl}}"], "path": ["api", "apartments", "9999"] }
      }
    },
    {
      "name": "Reviews - Add (protected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"body\": \"Great place, responsive landlord.\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/apartments/1/reviews", "host": ["{{baseUrl}}"], "path": ["api", "apartments", "1", "reviews"] }
      }
    },
    {
      "name": "Reviews - Add without token (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"body\": \"No token should be rejected.\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/apartments/1/reviews", "host": ["{{baseUrl}}"], "path": ["api", "apartments", "1", "reviews"] }
      }
    },
    {
      "name": "Comments - List for a review",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/reviews/1/comments", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "1", "comments"] }
      }
    },
    {
      "name": "Comments - Add (protected)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Thanks for the helpful review!\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/reviews/1/comments", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "1", "comments"] }
      }
    },
    {
      "name": "Uploads - Image (protected)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "image", "type": "file", "src": [] }]
        },
        "url": { "raw": "{{baseUrl}}/api/uploads", "host": ["{{baseUrl}}"], "path": ["api", "uploads"] }
      }
    }
  ]
}
